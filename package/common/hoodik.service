[Unit]
Description=securevaultx Drive
After=network.target

[Service]
Type=simple
Restart=always
RestartSec=30
User=securevaultx
ExecStart=/usr/bin/securevaultx
Environment="ENV_FILE=/etc/securevaultx.conf"
StandardOutput=append:/var/log/securevaultx.log
StandardError=append:/var/log/securevaultx.log

[Install]
WantedBy=multi-user.target
