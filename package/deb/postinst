#!/bin/sh
set -e

securevaultx_CONF="/etc/securevaultx.conf"
securevaultx_CONF_PERMS=640
securevaultx_HOME="/var/lib/securevaultx/"
securevaultx_DATA="${securevaultx_HOME}data/"
securevaultx_USER="securevaultx"

create_user() {
    if id ${securevaultx_USER} > /dev/null 2>&1; then return; fi
    adduser --system --home "${securevaultx_HOME}" --group ${securevaultx_USER}
}

generate_jwt_secret() {
    date | md5sum | awk '{print $1}'
}

create_config() {
    if [ ! -f "${securevaultx_CONF}" ]; then
        cp /usr/share/securevaultx/securevaultx.conf ${securevaultx_CONF}

        JWT_SECRET="$(generate_jwt_secret)"

        # Set the DATA_DIR into a persistent location
        sed -i "s|DATA_DIR=.*|DATA_DIR=${securevaultx_DATA}|" ${securevaultx_CONF} && echo "DATA_DIR=${securevaultx_DATA}"

        # Set the JWT_SECRET into a random value
        sed -i "s|# JWT_SECRET=.*|JWT_SECRET=${JWT_SECRET}|" ${securevaultx_CONF} && echo "JWT_SECRET=***"

        # Ensure that the config file has the correct ownership
        chown ${securevaultx_USER}:${securevaultx_USER} ${securevaultx_CONF}
        
        # Ensure that the config file has the correct permissions
        chmod ${securevaultx_CONF_PERMS} ${securevaultx_CONF}
    fi
}

create_user
create_config

